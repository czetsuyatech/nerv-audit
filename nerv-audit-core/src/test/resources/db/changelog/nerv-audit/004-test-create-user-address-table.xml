<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <changeSet id="004-create-user-address-table-1" author="czetsuya">
    <createSequence sequenceName="address_seq" startValue="1" incrementBy="1"/>
  </changeSet>

  <changeSet id="004-create-user-address-table-2" author="czetsuya">
    <createTable tableName="user_address">
      <column name="id" type="BIGINT" defaultValueSequenceNext="address_seq">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="street" type="varchar(255)"/>
      <column name="city" type="varchar(255)"/>
      <column name="country" type="varchar(255)"/>
      <column name="user_id" type="bigint">
        <constraints nullable="false"/>
      </column>
    </createTable>
  </changeSet>

  <changeSet id="004-create-user-address-table-3" author="czetsuya">
    <addForeignKeyConstraint
        baseTableName="user_address"
        baseColumnNames="user_id"
        referencedTableName="user_account"
        referencedColumnNames="id"
        constraintName="fk_user_address_user"/>
  </changeSet>

  <changeSet id="004-create-user-address-audit-table" author="czetsuya">
    <createTable tableName="user_address_aud">
      <column name="id" type="bigint"></column>
      <column name="rev" type="bigint"></column>
      <column name="revtype" type="bigint"></column>
      <column name="updated_by" type="varchar(255)"></column>
      <column name="updated" type="timestamp"></column>
      <column name="field_name" type="varchar(255)"></column>
      <column name="old_value" type="varchar(255)"></column>
      <column name="new_value" type="varchar(255)"></column>
    </createTable>
  </changeSet>

</databaseChangeLog>
